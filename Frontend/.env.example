# Sao chép thành .env.local rồi sửa theo máy (file .env.local không đưa lên Git).

# Địa chỉ BE (SWP.API) cho proxy /api của Vite dev server.
# Mặc định http://localhost:5214 (profile "http"). Chạy profile "https" thì dùng https://localhost:7023.
VITE_API_PROXY_TARGET=http://localhost:5214

# Chỉ cần khi build/deploy FE tách khỏi BE: gốc URL của BE (để trống = gọi cùng origin /api/...).
# VITE_API_BASE_URL=https://api.example.com
