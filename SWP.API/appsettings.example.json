{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=Horse_managerment;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Cloudinary": {
    "CloudName": "YOUR_CLOUD_NAME",
